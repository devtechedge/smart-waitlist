# =============================================================================
# Smart Waitlist & Referral Engine — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Then fill in the values from your Supabase project dashboard:
#   https://app.supabase.com/project/_/settings/api
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Public (client-safe, exposed to the browser via NEXT_PUBLIC_ prefix)
# -----------------------------------------------------------------------------
# Project URL: found in Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Anon public key: found in Supabase Dashboard → Settings → API → Project API keys → anon public
# Safe to expose; RLS policies enforce security.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# The public URL of your deployed app. Used to build absolute referral links.
# - Local dev:  http://localhost:3000
# - Preview:    https://your-preview-url.vercel.app
# - Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase — Service Role (SERVER-ONLY — NEVER expose to the browser)
# -----------------------------------------------------------------------------
# Service role key: found in Supabase Dashboard → Settings → API → Project API keys → service_role
# Bypasses RLS. Use ONLY in trusted server-side code (Server Actions, Route Handlers).
# DO NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# -----------------------------------------------------------------------------
# Database — Direct Postgres connection string (SERVER-ONLY)
# -----------------------------------------------------------------------------
# Used by Drizzle ORM for migrations (`db:push`, `db:migrate`, `db:studio`)
# and for server-side typed queries.
# Found in: Supabase Dashboard → Settings → Database → Connection string → URI
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# -----------------------------------------------------------------------------
# Admin — Optional allow-list of admin user emails (SERVER-ONLY)
# -----------------------------------------------------------------------------
# Comma-separated list of emails authorized to access /admin.
# Example: "admin@yourdomain.com,founder@yourdomain.com"
ADMIN_EMAILS="admin@example.com"

# -----------------------------------------------------------------------------
# Stripe — Optional, for real payments (SERVER-ONLY)
# -----------------------------------------------------------------------------
# Sign up at https://stripe.com. If not set, tier upgrades use demo mode (free).
# 1. Create products: Pro ($19/mo subscription) + Founder ($99 one-time)
# 2. Copy the price IDs (price_xxx) into STRIPE_PRO_PRICE_ID / STRIPE_FOUNDER_PRICE_ID
# 3. Set up webhook endpoint: https://your-app.com/api/webhooks/stripe
#    Events: checkout.session.completed, customer.subscription.deleted
# 4. Copy the webhook signing secret into STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=""
STRIPE_PRO_PRICE_ID=""
STRIPE_FOUNDER_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Resend — Optional, for email notifications (SERVER-ONLY)
# -----------------------------------------------------------------------------
# Sign up at https://resend.com (free: 100 emails/day).
# If not set, email sending is gracefully skipped.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Smart Waitlist <noreply@mail.yourdomain.com>"

# -----------------------------------------------------------------------------
# App metadata
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Smart Waitlist"
